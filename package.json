{
  "name": "datxe-rn",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm run start -w customer",
    "driver": "npm run start -w driver",
    "start:customer": "npm run customer",
    "start:driver": "npm run driver",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:architecture": "node scripts/check-architecture.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run check:architecture && npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
