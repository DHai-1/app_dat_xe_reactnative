{
  "expo": {
    "name": "PtitGo Driver",
    "slug": "drivemate-driver",
    "scheme": "drivemate-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.datxe.driver",
      "googleServicesFile": "./GoogleServiceDriver-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "PtitGo Tài xế",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.datxe.driver",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF4757",
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép DriveMate Tài Xế dùng camera để chụp xe và giấy tờ.",
          "photosPermission": "Cho phép DriveMate Tài Xế chọn ảnh giấy phép lái xe từ thư viện."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép DriveMate Tài Xế dùng vị trí để nhận cuốc gần bạn.",
          "locationAlwaysAndWhenInUsePermission": "Cho phép DriveMate Tài Xế theo dõi vị trí trong suốt chuyến đi.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": {},
      "googleWebClientId": {},
      "facebookAppId": {},
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f4c1c3a5-6e73-4502-b362-0724040bb358"
      }
    },
    "owner": "haidoan1s-team"
  }
}
